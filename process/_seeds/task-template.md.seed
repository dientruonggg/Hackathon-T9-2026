<!-- ════════════════════════════════════════════
     SECTION 0 — TASK CONTROL (master state record)
     ════════════════════════════════════════════ -->
<task_control>
  <status>BACKLOG</status>  <!-- BACKLOG | ACTIVE | BLOCKED | PAUSED | REVIEW | COMPLETED | CANCELLED -->
  <spec_level>S1</spec_level>  <!-- S0=sketch | S1=defined | S2=verified | S3=locked -->
  <priority>P2</priority>  <!-- P0=urgent | P1=high | P2=normal | P3=low -->
  <risk>MEDIUM</risk>  <!-- LOW | MEDIUM | HIGH -->
  <estimated_story_points>2</estimated_story_points>  <!-- 1 SP ≈ 2-4 focused engineering hours -->
  <working_mode>PAIR</working_mode>  <!-- PAIR (default: halts at each gate for review) | DELEGATED (fast-track: continuous autonomous run) | MANUAL | DIAGNOSE-ONLY -->
  <current_phase>RESEARCH</current_phase>  <!-- RESEARCH | INNOVATE | PLAN | EXECUTE | REVIEW -->
  <owner>@engineer</owner>
  <decision_owner>@engineer</decision_owner>
  <created></created>
  <last_updated></last_updated>
</task_control>

---

## 1. Specification (Pillar 1: Task / Spec)

<specification>
  <goal>
    [Target outcome, business value, or functional capability.]
  </goal>

  <current_behavior>
    [Current behavior prior to this change.]
  </current_behavior>

  <expected_behavior>
    [Expected behavior once the change is complete.]
  </expected_behavior>

  <actor_authorization>
    [Who initiates this action, under what authorization context.]
  </actor_authorization>

  <invariants>
    - [Invariant 1 — Conditions that must remain true throughout and after this change.]
  </invariants>

  <out_of_scope>
    - [Explicitly excluded components, refactoring, or undeclared API/schema changes.]
  </out_of_scope>

  <acceptance_criteria>
    - [ ] AC-1: [Verifiable functional behavior with explicit input and expected output]
    - [ ] AC-2: [Edge cases, validation rules, or error handling]
    - [ ] AC-3: [Automated tests added/updated and passing]
  </acceptance_criteria>

  <!-- Definition-of-Ready (DoR) Gate — Frontload the thinking before dispatch -->
  <definition_of_ready>
    - [ ] Target outcome and acceptance criteria are verifiable without guessing.
    - [ ] Invariants and <out_of_scope> boundaries are explicit.
    - [ ] Open questions resolved or scheduled in decision.md (No speculative coding).
    <!-- STOP: If any DoR item is unchecked, halt and ask clarifying questions first! -->
  </definition_of_ready>
</specification>

