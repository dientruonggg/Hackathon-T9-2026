{
  "name": "viewport-learning-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:extension": "npm run lint:extension --workspace @vlc/firefox-extension",
    "verify": "npm run typecheck && npm test && npm run build && npm run lint:extension",
    "dev:api": "npm run dev --workspace @vlc/agent-api",
    "dev:extension": "npm run dev --workspace @vlc/firefox-extension"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
