{
  "manifest_version": 2,
  "name": "Viewport Learning Companion",
  "version": "0.1.0",
  "description": "A user-activated learning companion for the current HTML viewport.",
  "permissions": ["activeTab", "tabs", "storage", "<all_urls>", "http://127.0.0.1:8787/*"],
  "background": {
    "scripts": ["src/background/index.ts"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Open Learning Companion"
  },
  "sidebar_action": {
    "default_title": "Learning Companion",
    "default_panel": "index.html",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "viewport-learning-companion@hackathon.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteActivity", "websiteContent"],
        "optional": []
      }
    }
  }
}
