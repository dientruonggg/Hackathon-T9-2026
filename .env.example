# Agent API
API_HOST=127.0.0.1
# MVP extension is built for this fixed port. Do not change without rebuilding its client/manifest.
API_PORT=8787
ALLOWED_ORIGIN_PREFIXES=moz-extension://*,http://localhost:*,http://127.0.0.1:*

# Mặc định demo: Ollama local, không cần tunnel và không cần key thật.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3:8b
OPENAI_TIMEOUT_MS=60000

# Nếu Agent API không cùng máy Ollama, có thể dùng Cloudflare Tunnel:
# OPENAI_BASE_URL=https://qwen.luongduytoan.io.vn/v1

# Fallback OpenRouter:
# OPENAI_API_KEY=replace-with-local-secret
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=provider/model-name

# Optional headers recommended by OpenRouter.
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Viewport Learning Companion
